{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?utc=00",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron?utc=01",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron?utc=02",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron?utc=03",
