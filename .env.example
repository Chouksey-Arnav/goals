# Set these in Vercel: Project → Settings → Environment Variables (Production).
# Never commit real values. Redeploy after adding them.

# Required
GMAIL_USER=you@gmail.com                 # the Gmail account that sends
GMAIL_APP_PASSWORD=abcdefghijklmnop       # 16-char app password, spaces optional
EMAIL_TO=you@gmail.com                   # where emails go; also the only email allowed to sign in
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # Supabase → Project Settings → API Keys → secret key
CRON_SECRET=long-random-string            # e.g. `openssl rand -hex 32`
GOALS_TZ=America/New_York                 # your IANA time zone

# Optional: more people (comma separated, up to 15 each, all sent as BCC)
# EMAIL_CC=me@school.edu, me2@example.com          # copies of ALL your emails, incl. one per tick: keep to your own addresses
# PARTNER_EMAILS=friend@example.com, sib@example.com # morning partner report on yesterday

# Optional
# APP_URL=https://goals-taupe-six.vercel.app
# GOALS_NAME=Arnav                        # greeting name; defaults to your contract signature
# EMAIL_MORNING_HOUR=7                    # local hour, 0-23
# EMAIL_MIDDAY_HOUR=14                    # fallback check-in if halfway never triggered it
# EMAIL_EVENING_HOUR=20
# EMAIL_FROM_NAME=Goals

# Optional: the calendar app (calendarforarnav)
# CALENDAR_SECRET=...                     # = CRON_SECRET of the calendar project; adds "Today on your calendar" to the morning email
# CALENDAR_URL=https://calendarforarnav.vercel.app
